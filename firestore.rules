rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User profile document
    match /users/{userId} {
      allow read, write, delete: if request.auth != null && request.auth.uid == userId;

      // Subcollections — must be explicitly granted, they don't inherit
      match /sleepHistory/{docId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }

      match /alarmInferences/{docId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }

      match /adaptiveData/{docId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }

      match /private/{docId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
